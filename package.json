{
  "name": "neonrush",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "build:single": "SINGLE=1 vite build --outDir dist-single",
    "level:report": "node scripts/report.mjs",
    "audio:check": "node scripts/audio.mjs http://localhost:4173/"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
